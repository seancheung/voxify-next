{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!package-lock.json", "!**/src/routeTree.gen.ts", "!drizzle/**/*"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "auto"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "info"
        },
        "noTailwindRawColors": "warn",
        "useTailwindStaticClassStrings": "warn",
        "useTailwindShorthandClasses": "off",
        "useTailwindVariablesShorthand": "warn"
      },
      "a11y": "off",
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "attributes": ["className", "[a-zA-Z]+ClassName"],
    "mergeFunctions": ["clsx", "cn", "tw"],
    "variantFunctions": ["cva"],
    "stylesheet": "./src/styles.css"
  }
}
